{
  "manifest_version": 3,
  "name": "Gulir",
  "version": "1.2.4",
  "minimum_chrome_version": "118",
  "description": "Screenshot satu PNG utuh, termasuk panel gulir vertikal yang didukung, preview, rename, dan simpan.",
  "permissions": [
    "activeTab",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Screenshot halaman • Alt+S",
    "default_icon": {
      "16": "icons/gulir-16.png",
      "32": "icons/gulir-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'"
  },
  "icons": {
    "16": "icons/gulir-16.png",
    "32": "icons/gulir-32.png",
    "48": "icons/gulir-48.png",
    "128": "icons/gulir-128.png"
  }
}
